# Meta tracking (Pixel + Conversions API). Set the values in Vercel; never commit tokens.
# Browser, build time: Pixel / dataset id. Falls back to the live id 1884233725563718 if empty.
VITE_META_PIXEL_ID=
# Server (api/meta/capi.ts): dataset id for CAPI. Falls back to VITE_META_PIXEL_ID, then the live id.
META_PIXEL_ID=
# Server only: Conversions API access token. Without it /api/meta/capi answers 503 and the site is unaffected.
META_CAPI_ACCESS_TOKEN=
# Server, optional: test event code from Events Manager > Test events.
META_TEST_EVENT_CODE=
